// OpenTelemetry OTLP pipeline: receive -> batch -> export to LGTM stack
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// Metrics -> Mimir (Prometheus remote write)
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir:9009/api/v1/push"
  }
}

// Logs -> Loki
otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// Traces -> Tempo (plain gRPC, no TLS)
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ========== RUM (Grafana Faro) ==========
// Browser apps send to Faro receiver; logs go to Loki via loki.process (to promote "kind" from log body to stream label), traces via batch to Tempo.
// The public dashboard filters by stream labels: Application, Environment, kind. Faro puts kind in the log body (logfmt); we promote it here.
faro.receiver "rum" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    cors_allowed_origins = ["*"]
  }
  // Public dashboard variables: Environment regex "K8S.*", Application regex "MainSpa". Use values that match so dropdowns and panels find data.
  extra_log_labels = {
    service     = "next-app",
    Application = "MainSpa",
    Environment = "K8S.development",
  }
  output {
    logs   = [loki.process.faro.receiver]
    traces = [otelcol.processor.batch.default.input]
  }
}

// Promote "kind" from log line (logfmt) to Loki stream label so dashboard queries {kind="measurement"} match.
loki.process "faro" {
  forward_to = [loki.write.default.receiver]

  stage.logfmt {
    mapping = { "kind" = "kind" }
  }
  stage.labels {
    values = { kind = "kind" }
  }
}
